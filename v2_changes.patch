++++  const cleanUrl = url.startsWith('http') || url.startsWith('mailto:') ? url : `https://${url}`
++++  return new ExternalHyperlink({
++++    link: cleanUrl,
++++    children: [
++++      new TextRun({ text, font: 'Times New Roman', size, color: '555555', underline: {} }),
++++    ],
++++  })
++++}
