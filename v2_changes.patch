++++++++++  }
++++++++++  // Gate 4: Screening -> Technical Round (Phase 2): If totalScreens >= 3 and technicalRounds < 1
++++++++++  else if (totalScreens >= 3 || screens30d >= 2) {
++++++++++    detectedPhaseId = 2
++++++++++  }
