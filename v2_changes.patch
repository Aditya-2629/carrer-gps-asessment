+++++++          candidateText = origText
+++++++        }
+++++++      }
+++++++
+++++++      // Check Number Integrity on project rewrites
+++++++      const fabricated = findNumberViolations(origText, candidateText)
+++++++      if (fabricated.length > 0) {
