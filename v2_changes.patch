+++++++        const hasDomainOverlap = aliases.some((al) => candidateText.toLowerCase().includes(al))
+++++++        if (hasDomainOverlap && !candidateText.toLowerCase().includes(kwLow)) {
+++++++          const res = injectKeywordNaturally(candidateText, keyword)
+++++++          if (res.injected) {
