+++++++++++  }
+++++++++++
+++++++++++  // Banned generic words & prepositions
+++++++++++  if (BANNED_GENERIC_WORDS.has(low)) return false
+++++++++++
+++++++++++  // Disallow single generic lowercase words without punctuation or digits
