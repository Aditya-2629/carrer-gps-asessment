++++++++    : 'US Citizen / Permanent Resident'
++++++++
++++++++  const searchPipelineModel = requiresSponsorship ? 'Sponsorship-Optimized Direct Sourcing' : 'Standard Market Inbound/Outbound'
++++++++
++++++++  return {
++++++++    parsedYoe,
++++++++    timelineYoe,
++++++++    effectiveYoe,
++++++++    seniorityTier,
