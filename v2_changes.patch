+++++// In-memory cache for normalized taxonomy terms
+++++export const TAXONOMY_CANONICAL_CACHE = new Map()
+++++
+++++// Pre-seed known synonyms and noise terms into cache
+++++Object.entries(CANONICAL_SYNONYMS).forEach(([term, canon]) => {
