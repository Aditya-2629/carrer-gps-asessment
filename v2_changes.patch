+++++++++    .replace(/&lt;/gi, '<')
+++++++++    .replace(/&gt;/gi, '>')
+++++++++    .replace(/&quot;/gi, '"')
+++++++++    .replace(/&#39;|&apos;/gi, "'")
+++++++++}
