++++++++++++        ],
++++++++++++      },
++++++++++++    ],
++++++++++++    projects: [
++++++++++++      {
++++++++++++        title: 'Enterprise Telemetry Streaming Platform',
++++++++++++        techStack: 'Python, Kafka, PostgreSQL, Docker',
++++++++++++        bullets: [
++++++++++++          'Engineered real-time event streaming platform handling 50k events/sec.',
++++++++++++        ],
++++++++++++      },
++++++++++++    ],
