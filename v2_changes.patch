++++++++++++// Shared range-safe numeric parser that prevents concatenating range digits (e.g. "30–60" -> 45, never 3060)
++++++++++++export function parseRangeOrNumber(val, fallback = 0) {
++++++++++++  if (val === null || val === undefined) return fallback
