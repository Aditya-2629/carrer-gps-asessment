+++++++          type: 'number_violation',
+++++++          original: origText,
+++++++          rewrite: candidateText,
+++++++          fabricatedNumbers: fabricated,
+++++++          message: `Fabricated numbers [${fabricated.join(', ')}] in ${pbId}; reverted to original text.`,
+++++++        })
+++++++        candidateText = origText
+++++++      }
