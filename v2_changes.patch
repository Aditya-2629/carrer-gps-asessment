++++++++++ * (e.g. "by by", "with with"), removes dangling prepositions before punctuation, and normalizes whitespace.
++++++++++ */
++++++++++export function cleanGrammarArtifacts(text) {
++++++++++  if (!text || typeof text !== 'string') return ''
