+++++  ['cisco', { name: 'Cisco Systems', tier: 'Tier-1 Sponsor', approvals: '900+' }],
+++++  ['intel', { name: 'Intel Corporation', tier: 'Tier-1 Sponsor', approvals: '1,300+' }],
