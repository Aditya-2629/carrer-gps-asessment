+++++++++      try {
+++++++++        const fallbackResponse = await llmGateway.generate({
+++++++++          purpose: 'assessment_report',
+++++++++          task: 'report_chatbot',
+++++++++          preferredProvider: 'openrouter',
+++++++++          model: 'google/gemini-3-flash-preview',
+++++++++          messages,
+++++++++          responseFormat: 'text',
+++++++++          temperature: 0.3,
+++++++++          maxTokens: 1024,
+++++++++          timeoutMs: 30000,
+++++++++        })
+++++++++        replyText = fallbackResponse.text
