+++++++++      const response = await llmGateway.generate({
+++++++++        purpose: 'assessment_report',
+++++++++        task: 'report_chatbot',
+++++++++        preferredProvider: 'openrouter',
+++++++++        model: 'google/gemini-3.5-flash-lite',
+++++++++        messages,
+++++++++        responseFormat: 'text',
+++++++++        temperature: 0.3,
+++++++++        maxTokens: 1024,
+++++++++        maxRetries: 2,
+++++++++        timeoutMs: 30000,
+++++++++      })
+++++++++      replyText = response.text
+++++++++    } catch (openRouterErr) {
