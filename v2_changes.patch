+++++def decode_html_entities(s):
+++++    if not s or not isinstance(s, str):
+++++        return ""
+++++    import html
+++++    s = html.unescape(s)
+++++    s = s.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>').replace('&quot;', '"').replace('&#39;', "'")
+++++    return s.strip()
