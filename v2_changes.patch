+++++++++  const finals90d = Number(ans.funnel90d?.finalRounds ?? ans.funnel90d?.finals ?? ans.finalRounds ?? ans.finals ?? 0)
+++++++++  const finals30d = Math.max(Math.round(finals90d / 3), Number(ans.finalRounds30d ?? ans.finals30d ?? 0))
