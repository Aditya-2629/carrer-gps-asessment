+++++export function classifyChatIntent(question = '') {
+++++  for (const intent of CHAT_INTENTS) {
+++++    if (intent.match.test(question)) return intent
+++++  }
+++++  return { id: 'general', section: 'overview', label: 'Executive Overview' }
