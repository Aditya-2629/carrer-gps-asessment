+++++++
+++++++  if (contactRuns.length > 0) {
+++++++    children.push(
+++++++      new Paragraph({
+++++++        alignment: AlignmentType.CENTER,
+++++++        spacing: { before: 0, after: config.tightSpacing ? 70 : 90 }, // 4.5pt after
+++++++        children: contactRuns,
+++++++      })
