+++++++++      ...historyMessages,
+++++++++      { role: 'user', content: userMessageContent },
+++++++++    ]
+++++++++
+++++++++    // Paid Priority Execution: Gemini 3.5 Flash Lite -> DeepSeek V3 -> Gemini 3 Flash Preview -> Gemini 3.5 Flash
+++++++++    let replyText = ''
+++++++++    try {
