++++++++++++  let current = []
++++++++++++  let depth = 0
++++++++++++
++++++++++++  for (let i = 0; i < rawSkillStr.length; i++) {
++++++++++++    const ch = rawSkillStr[i]
++++++++++++    if (ch === '(') depth++
++++++++++++    else if (ch === ')') depth = Math.max(0, depth - 1)
++++++++++++
++++++++++++    if ((ch === ',' || ch === ';') && depth === 0) {
++++++++++++      const token = current.join('').trim()
++++++++++++      if (token) tokens.push(token)
++++++++++++      current = []
++++++++++++    } else {
