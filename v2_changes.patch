++++++  const rangeMatch = str.match(/(\d+)\s*[–—-]\s*(\d+)/)
++++++  if (rangeMatch) {
++++++    const low = parseInt(rangeMatch[1], 10)
++++++    const high = parseInt(rangeMatch[2], 10)
++++++    return Math.round((low + high) / 2)
++++++  }
