+
+  const expProfiles = expClones.map((exp, idx) => {
+    const rawBullets = (exp.bullets || []).map((b) => (typeof b === 'string' ? b : b?.text || ''))
+    return {
+      index: idx,
+      company: exp.company || `Company ${idx + 1}`,
+      isCurrent: isRoleCurrent(exp),
+      bullets: [...rawBullets],
+      modifiedCount: 0,
+      synthesizedCount: 0,
