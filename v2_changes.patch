+++++/**
+++++ * Decodes HTML entities (handles &amp;, &Amp;, &lt;, &gt;, &quot;, &#39;, &apos;, &#x2F;)
+++++ */
+++++export function decodeHtmlEntities(str) {
+++++  if (!str || typeof str !== 'string') return str
+++++  return str
+++++    .replace(/&(?:amp|Amp);?/gi, '&')
+++++    .replace(/&lt;/gi, '<')
+++++    .replace(/&gt;/gi, '>')
+++++    .replace(/&quot;/gi, '"')
+++++    .replace(/&#39;|&apos;/gi, "'")
+++++    .replace(/&#x2F;/gi, '/')
+++++}
+++++
+++++/**
+++++ * Normalizes target role title to prevent duplicate prefixes (e.g. "Senior Senior Full Stack...")
+++++ */
+++++export function cleanTargetRoleTitle(prefix, baseRole) {
+++++  if (!baseRole && !prefix) return 'Professional'
+++++  if (!baseRole) return String(prefix).trim()
+++++  if (!prefix) {
+++++    return String(baseRole)
+++++      .replace(/^((?:senior|lead|principal|staff|junior|mid-level)\s+)(?:\1)+/i, '$1')
+++++      .trim()
+++++  }
+++++  const clean = String(baseRole).replace(/^((?:senior|lead|principal|staff|junior|mid-level)\s+)+/i, '').trim()
+++++  return `${String(prefix).trim()} ${clean}`.trim()
+++++}
+++++
+++++/**
+++++ * Gracefully cleans placeholder clauses from bullet rewrites
+++++ * E.g. "...reducing approval latency by [ADD: 40%]." -> clean period "."
+++++ * Never eats trailing clauses (e.g. "...by [ADD: ...] and boosted system throughput." -> "...and boosted system throughput.")
+++++ */
+++++export function cleanPlaceholderGraceful(text) {
+++++  if (!text || typeof text !== 'string') return ''
+++++  let cleaned = decodeHtmlEntities(text)
+++++  // Strip unrendered template variables like {{targetRole}} or {{currentCompany}}
+++++  cleaned = cleaned.replace(/\{\{[A-Za-z0-9_]+\}\}/g, '')
+++++
+++++  // 1. Strip subordinate participial clauses containing placeholders: e.g. ", reducing latency by [ADD: ...]" or ", achieving [ADD: ...] across teams."
+++++  cleaned = cleaned.replace(/,\s*(?:reducing|securing|achieving|supporting|delivering|improving|cutting|saving|driving|scaling|optimizing|boosting|generating|utilizing|leveraging)(?:\s+[a-z0-9\s]+)?\s*(?:by|with|to)?\s*\[(?:ADD|TODO|TBD|INSERT)[^\]]*\](?:\s+across\s+[a-z0-9\s]+)?/gi, '')
+++++
+++++  // 2. Strip dangling verbs immediately preceding bracket placeholders: e.g. "utilized by [ADD: ...]" or "leveraged with [ADD: ...]"
+++++  cleaned = cleaned.replace(/\s+(?:utilized|leveraged|achieving|securing|supporting|delivering|utilizing|driving|scaling)\s*(?:by|with|to)?\s*\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]/gi, '')
+++++
+++++  // 3. Replace 'by [ADD: ...] and boosted...' -> 'and boosted...'
+++++  cleaned = cleaned.replace(/\b(?:by|with)\s*\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]\s*(and|while|to)\b/gi, '$1')
+++++
+++++  // 4. Strip any remaining raw bracket placeholder: e.g. "[ADD: ...]"
+++++  cleaned = cleaned.replace(/\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]/gi, '')
+++++
+++++  // Purge repetitive microservice boilerplate clauses
+++++  cleaned = cleaned.replace(/,?\s*by establishing decoupled microservice boundaries and resilient caching(?:,\s*enhancing operational throughput,\s*reducing execution latency,\s*and ensuring continuous production uptime)?\.?/gi, '.')
+++++  cleaned = cleaned.replace(/,?\s*enhancing operational throughput,\s*reducing execution latency,\s*and ensuring continuous production uptime\.?/gi, '.')
+++++
+++++  // 4b. Collapse duplicated prepositions
+++++  cleaned = cleaned.replace(/\b(by|with|to|in|of|for|and|on|at|from)\s+\1\b/gi, '$1')
+++++
+++++  // 5. Clean hanging verbs or prepositions left before punctuation at sentence boundaries: e.g. "utilized." -> "." or "by." -> "."
+++++  cleaned = cleaned.replace(/\s+(?:utilized|leveraged|utilizing|achieved|driven|by|with|to|of|for|at|in|from)\s*([.,;])/gi, '$1')
+++++
+++++  // 6. Normalize punctuation and whitespace: e.g. ",." -> "."
+++++  cleaned = cleaned.replace(/\s*,\s*\./g, '.')
+++++  cleaned = cleaned.replace(/,\s*,/g, ',')
+++++  cleaned = cleaned.replace(/\s{2,}/g, ' ').trim()
+++++  cleaned = cleaned.replace(/\s+\./g, '.')
+++++  cleaned = cleaned.replace(/\.+$/, '.')
+++++  if (cleaned && !/[.!?]$/.test(cleaned)) {
+++++    cleaned += '.'
+++++  }
+++++  return cleaned
+++++}
+++++export const cleanPlaceholderClause = cleanPlaceholderGraceful
+++++
+++++/**
+++++ * Builds multi-strategy rewrite index:
+++++ * 1. bulletId / id exact match
+++++ * 2. exact text match (case-insensitive, trimmed)
+++++ * 3. 35-character normalized prefix match
+++++ */
+++++export function buildRewriteLookup(tailoredBullets = []) {
+++++  const idMap = new Map()
+++++  const exactMap = new Map()
+++++  const prefixMap = new Map()
+++++
+++++  const normalizePrefix = (str, len = 35) => {
+++++    if (!str) return ''
+++++    return String(str)
+++++      .toLowerCase()
+++++      .replace(/^([•\-\*\u2022\u25e6\u2043\u2219]|\*(?!\*))\s*/, '')
+++++      .replace(/\s+/g, ' ')
+++++      .trim()
+++++      .slice(0, len)
+++++  }
+++++
+++++  if (Array.isArray(tailoredBullets)) {
+++++    tailoredBullets.forEach((item) => {
+++++      if (!item) return
+++++      const id = item.bulletId || item.id
+++++      const origText = item.originalText || item.text || item.original || item.bullet || ''
+++++      const rawRewrite =
+++++        item.rewriteOption ||
+++++        item.rewrite ||
+++++        item.suggestedRewrite ||
+++++        item.rewrittenText ||
+++++        item.readyToUseRewrite ||
+++++        (item.originalText && item.text !== item.originalText ? item.text : null)
+++++
+++++      if (!rawRewrite || typeof rawRewrite !== 'string') return
+++++
+++++      const cleanRw = cleanPlaceholderClause(rawRewrite)
+++++      if (!cleanRw) return
+++++
+++++      const hadPlaceholder = PLACEHOLDER_REGEX.test(rawRewrite)
+++++      const entry = { text: cleanRw, hadPlaceholder, raw: rawRewrite }
+++++
+++++      if (id) {
+++++        idMap.set(String(id), entry)
+++++      }
+++++      if (origText && typeof origText === 'string') {
+++++        const normExact = origText.toLowerCase().trim()
+++++        exactMap.set(normExact, entry)
+++++        const pfx = normalizePrefix(origText, 35)
+++++        if (pfx.length >= 10) {
+++++          prefixMap.set(pfx, entry)
+++++        }
+++++      }
+++++    })
+++++  }
+++++
+++++  return {
+++++    findRewrite(bulletId, rawText) {
+++++      if (bulletId && idMap.has(String(bulletId))) {
+++++        return idMap.get(String(bulletId))
+++++      }
+++++      if (rawText && typeof rawText === 'string') {
+++++        const normExact = rawText.toLowerCase().trim()
+++++        if (exactMap.has(normExact)) {
+++++          return exactMap.get(normExact)
+++++        }
+++++        const pfx = normalizePrefix(rawText, 35)
+++++        if (pfx.length >= 10 && prefixMap.has(pfx)) {
+++++          return prefixMap.get(pfx)
+++++        }
+++++      }
+++++      return null
+++++    },
+++++  }
+++++}
+++++
+++++/**
+++++ * Categorizes a skill into an exact ATS bucket based on universal multi-domain taxonomy
+++++ */
+++++export function determineSkillBucket(skill, targetRole = '') {
+++++  const low = String(skill || '').toLowerCase().trim()
+++++
+++++  // 1. Non-Tech / Functional Roles (Product, Operations, Healthcare, Finance, HR, Marketing, Sales)
+++++  const isNonTechRole =
+++++    /product\s+manager|project\s+manager|scrum|design|ux\b|ui\b|marketing|sales|recruiter|human\s+resources|hr\b|finance|financial|accountant|nurse|healthcare|clinical|operations|supply\s+chain|compliance|business\s+analyst/i.test(targetRole) &&
+++++    !/engineer|developer|architect|data\s+scientist|data\s+engineer|devops/i.test(targetRole)
+++++
+++++  if (isNonTechRole) {
+++++    if (/jira|figma|excel|powerpoint|word|salesforce|sap|epic|workday|asana|trello|hubspot|tableau|power\s*bi|quickbooks|notion|confluence|slack|postman|software|system|tool|crm|erp/i.test(low)) {
+++++      return 'Tools & Systems'
+++++    }
+++++    return 'Core Competencies'
+++++  }
+++++
+++++  // 2. Data Roles (Data Analyst, BI, Analytics Engineer)
+++++  const isDataRole = /data|analyst|analytics|bi\b|sql|tableau|power bi/i.test(targetRole) && !/software|full\s*stack|backend/i.test(targetRole)
+++++
+++++  if (isDataRole) {
+++++    if (/sql|snowflake|bigquery|postgresql|mysql|t-sql|queries/i.test(low)) return 'SQL & Core Database'
+++++    if (/power bi|tableau|looker|excel|dashboards|reporting|dax/i.test(low)) return 'BI & Visualization'
+++++    if (/python|machine learning|predictive|regression|hypothesis|a\/b|pandas|numpy/i.test(low)) return 'Analytics & Machine Learning'
+++++    if (/aws|azure|dbt|alteryx|airflow|etl|databricks|spark/i.test(low)) return 'Cloud & Data Engineering'
+++++    return 'Business Analysis & Process'
+++++  }
+++++
+++++  // 3. Technical Universal Taxonomy (SWE, DevOps, AI/ML, Cloud)
+++++  // Programming Languages & Frameworks
+++++  if (/python|javascript|typescript|go\b|golang|bash|c\+\+|java\b|\bc\b|\br\b|rust|c#|ruby|php|kotlin|swift/i.test(low)) {
+++++    return 'Programming Languages'
+++++  }
+++++  // AI & Machine Learning Systems
+++++  if (/langchain|fastmcp|smolagents|rag|llm|tensorflow|pytorch|openai|gemini|nlp|genai|scikit|huggingface/i.test(low)) {
+++++    return 'AI & Machine Learning Systems'
+++++  }
+++++  // Cloud & DevOps
+++++  if (/aws|docker|kubernetes|terraform|ci\/cd|jenkins|git\b|cloud|linux|gcp|azure|ansible|helm/i.test(low)) {
+++++    return 'Cloud & DevOps'
+++++  }
+++++  // Databases & Data Systems / Messaging
+++++  if (/sql|postgresql|postgres|mysql|sqlite|mongodb|redis|cassandra|elasticsearch|dynamodb|kafka|rabbitmq|pub\/sub|message queue|caching|snowflake|dbt|spark/i.test(low)) {
+++++    return 'Databases & Messaging'
+++++  }
+++++  // Analytics, BI & Tools
+++++  if (/tableau|power\s*bi|excel|jira|figma|postman|splunk|grafana|datadog|looker|confluence/i.test(low)) {
+++++    return 'Analytics, BI & Tools'
+++++  }
+++++  // Core Domain Competencies
+++++  if (/project management|regulatory compliance|financial modeling|system architecture|agile|sdlc|cross-functional/i.test(low)) {
+++++    return 'Core Domain Competencies'
+++++  }
+++++  // Backend & APIs (e.g. Spring Boot, FastAPI, Node.js, Express, REST, GraphQL, JWT / OAuth 2.0, microservices)
+++++  if (/fastapi|node|express|flask|django|react|next\.js|rest|graphql|microservices|system design|spring|spring boot|api|apis|jwt|oauth|auth0/i.test(low)) {
+++++    return 'Backend & APIs'
+++++  }
+++++
+++++  if (/database|query|queries|cache/i.test(low)) return 'Databases & Messaging'
+++++  return 'Backend & APIs'
+++++}
