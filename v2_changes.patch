+++++++++  if (/typescript|javascript|react|next\.?js|vue|angular|tailwind|redux|graphql/i.test(low)) {
+++++++++    return 'frontend_ui'
+++++++++  }
+++++++++  // Default: Backend / Services API
+++++++++  return 'backend_api'
