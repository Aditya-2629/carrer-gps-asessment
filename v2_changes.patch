+++++++++
+++++++++    # 1. Header: Candidate Name, Title, Contact
+++++++++    name = decode_html_entities(resume_data.get('candidate_name') or resume_data.get('name') or 'Candidate Name')
+++++++++    p_name = add_p(space_after=1.5, align=WD_ALIGN_PARAGRAPH.CENTER)
