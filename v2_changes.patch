+++/**
+++ * Checks if a URL is fake, dummy, or sentinel
+++ */
+++function isFakeUrl(url) {
+++  if (!url) return true
+++  return /example\.com|fakeurl|dummy|placeholder|localhost|\[|\]/i.test(url)
