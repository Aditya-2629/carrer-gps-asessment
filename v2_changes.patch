+++++++++    })
+++++++++  }
+++++++++
+++++++++  return {
+++++++++    buffer: bestBuffer,
+++++++++    pages: finalPages,
+++++++++    mode: fitMode,
+++++++++    warnings,
+++++++++    appliedKeywords,
+++++++++    pendingKeywords,
+++++++++  }
+++++++++}
