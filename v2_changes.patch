++++++++++    funnelSummary: {
++++++++++      applications30d: apps30d,
++++++++++      applications90d: ans.funnel90d?.applications90d ?? (apps30d * 3),
++++++++++      recruiterScreens,
++++++++++      assessments,
++++++++++      aiInterviews,
++++++++++      screens90d,
++++++++++      screens30d,
++++++++++      technicalRounds: techs90d,
++++++++++      finalRounds: finals90d,
++++++++++      offers: offers90d,
