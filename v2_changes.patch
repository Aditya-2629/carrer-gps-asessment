++++++++    if (dynamicCategory === 'cloud_devops') return 'cloud_slot'
++++++++    if (dynamicCategory === 'testing_quality') return 'testing_slot'
++++++++    if (dynamicCategory === 'ai_ml') return 'api_slot'
++++++++    if (dynamicCategory === 'database_data') {
