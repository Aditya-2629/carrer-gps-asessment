++export function splitIntoSentencesSafely(text) {
++  if (!text || typeof text !== 'string') return []
++  return text
++    .split(/(?<=(?<!\b(?:M\.S|B\.S|Ph\.D|B\.Tech|M\.Tech|e\.g|i\.e|Dr|Mr|Ms|U\.S))[.?!])\s+/i)
++    .map((s) => s.trim())
