+++++++++++  const acronymMatches = text.match(/\b[A-Z]{2,5}\b|\b[a-z][A-Z0-9]+\b|\b[A-Z][a-z]+[A-Z][a-zA-Z]*\b|\b[A-Z]{1,5}\d{1,4}\b/g) || []
