++++++++function cleanText(str) {
++++++++  if (!str || typeof str !== 'string') return ''
++++++++  return str
++++++++    .replace(/&(?:amp|Amp);?/gi, '&')
++++++++    .replace(/&lt;/gi, '<')
++++++++    .replace(/&gt;/gi, '>')
++++++++    .replace(/&quot;/gi, '"')
++++++++    .replace(/&#39;|&apos;/gi, "'")
++++++++    .replace(/\[ADD:[^\]]*\]/gi, '') // Strip unresolved placeholders
++++++++    .replace(/\s{2,}/g, ' ')
++++++++    .trim()
++++++++}
