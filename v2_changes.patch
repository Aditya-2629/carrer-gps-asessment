++++++++++++            skillOccurrences.set(key, {
++++++++++++              canonicalName: canonical,
++++++++++++              category: item.category || 'tools',
++++++++++++              count: 0,
++++++++++++              requiredCount: 0,
++++++++++++              preferredCount: 0,
++++++++++++            })
++++++++++++          }
++++++++++++          const entry = skillOccurrences.get(key)
++++++++++++          entry.count += 1
++++++++++++          if (item.isRequired) entry.requiredCount += 1
++++++++++++          else entry.preferredCount += 1
++++++++++++        }
++++++++++++      }
++++++++++++    }
