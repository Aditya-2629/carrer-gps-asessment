+++++++  jun: 'June', june: 'June',
+++++++  jul: 'July', july: 'July',
+++++++  aug: 'August', august: 'August',
+++++++  sep: 'September', sept: 'September', september: 'September',
+++++++  oct: 'October', october: 'October',
+++++++  nov: 'November', november: 'November',
+++++++  dec: 'December', december: 'December',
+++++++}
+++++++
+++++++/**
+++++++ * Education Date Formatter
+++++++ * Expands abbreviations to full month names and standardizes ranges with en-dash.
+++++++ * E.g. "Sep 2024 - May 2026" -> "September 2024 – May 2026", "2024" -> "2024"
+++++++ */
+++++++export function formatEducationDates(dates, startDate, endDate) {
+++++++  const expandMonth = (str) => {
+++++++    if (!str) return ''
+++++++    return String(str)
+++++++      .replace(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?\s+(\d{4})\b/gi, (match, m, y) => {
+++++++        const full = FULL_MONTHS[m.toLowerCase()] || m
+++++++        return `${full} ${y}`
+++++++      })
+++++++      .replace(/\b(0?[1-9]|1[0-2])\/(\d{4})\b/g, (match, m, y) => {
+++++++        const monthNames = ['', 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
+++++++        const full = monthNames[parseInt(m, 10)] || m
+++++++        return `${full} ${y}`
+++++++      })
+++++++  }
+++++++
+++++++  let s = startDate ? expandMonth(String(startDate).trim()) : ''
+++++++  let e = endDate ? expandMonth(String(endDate).trim()) : ''
+++++++
+++++++  if (s && e && s !== e) {
+++++++    return `${s} – ${e}`
+++++++  }
+++++++  if (!dates) return e || s || ''
+++++++
+++++++  let clean = expandMonth(String(dates).trim())
+++++++  clean = clean.replace(/\s*(?:–|—|-|\bto\b)\s*/gi, ' – ')
+++++++  clean = clean.replace(/\bexpected\b/i, 'Expected')
+++++++  return clean
+++++++}
+++++++
+++++++/**
+++++++ * Universal Education Item Normalizer
+++++++ * Guarantees distinct school, degree, location, and full-month dates.
+++++++ */
+++++++export function normalizeEducationItem(edu) {
+++++++  if (!edu) return { school: '', degree: '', location: '', dates: '' }
+++++++  if (typeof edu === 'string') {
+++++++    let raw = edu
+++++++    let location = ''
+++++++    const locMatch = raw.match(/\b([A-Za-z\s.-]+,\s*[A-Z]{2}(?:\s*USA)?|[A-Za-z\s.-]+,\s*(?:India|USA|UK|Canada|Germany))\b/i)
+++++++    if (locMatch) {
+++++++      location = locMatch[0].trim()
+++++++      raw = raw.replace(locMatch[0], '')
+++++++    }
+++++++
+++++++    let dates = ''
+++++++    const dateMatch = raw.match(
+++++++      /\b(?:expected\s+)?(?:(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?\s+)?(?:\d{4})\s*(?:–|—|-|\bto\b)\s*(?:(?:(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?\s+)?(?:\d{4})|present|current|expected)\b|\b(?:expected\s+)?(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?\s+(?:19|20)\d{2}\b|\b(?:expected\s+)?(?:19|20)\d{2}\b/i
+++++++    )
+++++++    if (dateMatch) {
+++++++      dates = dateMatch[0].trim()
+++++++      raw = raw.replace(dateMatch[0], '')
+++++++    }
+++++++
+++++++    const remaining = raw.split(/,\s*/).map((p) => p.trim()).filter((p) => p.length >= 2)
+++++++    let school = ''
+++++++    let degree = ''
+++++++    for (const p of remaining) {
+++++++      if (/\b(university|institute|college|school|academy|polytechnic|iit|nit|bits|kit|stevens)\b/i.test(p)) {
+++++++        school = p
+++++++      } else if (/\b(master|bachelor|b\.?tech|m\.?tech|m\.?s\.?|b\.?s\.?|ph\.?d|mba|associate|science|degree|engineering)\b/i.test(p)) {
+++++++        degree = p
+++++++      } else if (!school) {
+++++++        school = p
+++++++      } else if (!degree) {
+++++++        degree = p
+++++++      }
+++++++    }
+++++++    return {
+++++++      school,
+++++++      degree,
+++++++      location,
+++++++      dates: formatEducationDates(dates),
+++++++    }
+++++++  }
+++++++
+++++++  let school = safeString(edu.school || edu.institution || edu.university || '').trim()
+++++++  let degree = safeString(edu.degree || edu.degreeName || '').trim()
+++++++  let location = extractLocation(edu.location)
+++++++  const rawDateCandidate =
+++++++    edu.dates ||
+++++++    edu.year ||
+++++++    edu.graduationYear ||
+++++++    edu.graduationDate ||
+++++++    edu.gradYear ||
+++++++    edu.gradDate ||
+++++++    edu.date ||
+++++++    edu.period ||
+++++++    edu.completionDate ||
+++++++    edu.time ||
+++++++    ''
+++++++  let dates = formatEducationDates(rawDateCandidate, edu.startDate, edu.endDate)
+++++++
+++++++  // Recovery: if dates is missing or empty, search school and degree for valid graduation date
+++++++  if (!dates) {
+++++++    const embeddedDateRegex = /\b(?:expected\s+)?(?:(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?\s+)?(?:\d{4})\s*(?:–|—|-|\bto\b)\s*(?:(?:(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?\s+)?(?:\d{4})|present|current|expected)\b|\b(?:expected\s+)?(?:jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?\s+(?:19|20)\d{2}\b|\b(?:expected\s+)?(?:19|20)\d{2}\b/i
+++++++    const mDeg = degree.match(embeddedDateRegex)
+++++++    if (mDeg) {
+++++++      dates = formatEducationDates(mDeg[0])
+++++++      degree = degree.replace(mDeg[0], '').replace(/[(),]/g, ' ').replace(/\s+/g, ' ').trim()
+++++++    } else {
+++++++      const mSch = school.match(embeddedDateRegex)
+++++++      if (mSch) {
+++++++        dates = formatEducationDates(mSch[0])
+++++++        school = school.replace(mSch[0], '').replace(/[(),]/g, ' ').replace(/\s+/g, ' ').trim()
+++++++      }
+++++++    }
+++++++  }
+++++++
+++++++  // Location recovery if location is missing but inside school or degree
+++++++  if (!location) {
+++++++    const locRegex = /,\s*([A-Za-z\s.-]+,\s*[A-Z]{2}(?:\s*USA)?|[A-Za-z\s.-]+,\s*(?:India|USA|UK|Canada|Germany))\s*$/i
+++++++    const mSchool = school.match(locRegex)
+++++++    if (mSchool) {
+++++++      location = mSchool[1].trim()
+++++++      school = school.replace(locRegex, '').trim()
+++++++    } else {
+++++++      const mDegree = degree.match(locRegex)
+++++++      if (mDegree) {
+++++++        location = mDegree[1].trim()
+++++++        degree = degree.replace(locRegex, '').trim()
+++++++      }
+++++++    }
+++++++  }
+++++++
+++++++  // If school is missing but degree contains an institution name
+++++++  if (!school && degree && /\b(university|institute|college|school|academy|polytechnic|iit|nit|bits|kit|stevens)\b/i.test(degree)) {
+++++++    const parts = degree.split(/,\s*/)
+++++++    if (parts.length >= 2) {
+++++++      const instIdx = parts.findIndex((p) => /\b(university|institute|college|school|academy|polytechnic|iit|nit|bits|kit|stevens)\b/i.test(p))
+++++++      if (instIdx !== -1) {
+++++++        school = parts[instIdx].trim()
+++++++        degree = parts.filter((_, i) => i !== instIdx).join(', ').trim()
+++++++      }
+++++++    }
+++++++  }
+++++++
+++++++  if (SENTINEL_ONLY.test(school)) school = ''
+++++++  if (SENTINEL_ONLY.test(degree)) degree = ''
+++++++
+++++++  return { school, degree, location, dates }
+++++++}
+++++++
+++++++/**
+++++++ * Decodes HTML entities (handles &amp;, &Amp;, &lt;, &gt;, &quot;, &#39;, &apos;, &#x2F;)
+++++++ */
+++++++export function decodeHtmlEntities(str) {
+++++++  if (!str || typeof str !== 'string') return str
+++++++  return str
+++++++    .replace(/&(?:amp|Amp);?/gi, '&')
+++++++    .replace(/&lt;/gi, '<')
+++++++    .replace(/&gt;/gi, '>')
+++++++    .replace(/&quot;/gi, '"')
+++++++    .replace(/&#39;|&apos;/gi, "'")
+++++++    .replace(/&#x2F;/gi, '/')
+++++++}
+++++++
+++++++/**
+++++++ * Normalizes target role title to prevent duplicate prefixes (e.g. "Senior Senior Full Stack...")
+++++++ */
+++++++export function cleanTargetRoleTitle(prefix, baseRole) {
+++++++  if (!baseRole && !prefix) return 'Professional'
+++++++  if (!baseRole) return String(prefix).trim()
+++++++  if (!prefix) {
+++++++    return String(baseRole)
+++++++      .replace(/^((?:senior|lead|principal|staff|junior|mid-level)\s+)(?:\1)+/i, '$1')
+++++++      .trim()
+++++++  }
+++++++  const clean = String(baseRole).replace(/^((?:senior|lead|principal|staff|junior|mid-level)\s+)+/i, '').trim()
+++++++  return `${String(prefix).trim()} ${clean}`.trim()
+++++++}
+++++++
+++++++/**
+++++++ * Gracefully cleans placeholder clauses from bullet rewrites
+++++++ * E.g. "...reducing approval latency by [ADD: 40%]." -> clean period "."
+++++++ * Never eats trailing clauses (e.g. "...by [ADD: ...] and boosted system throughput." -> "...and boosted system throughput.")
+++++++ */
+++++++export function cleanPlaceholderGraceful(text) {
+++++++  if (!text || typeof text !== 'string') return ''
+++++++  let cleaned = decodeHtmlEntities(text)
+++++++  // Strip unrendered template variables like {{targetRole}} or {{currentCompany}}
+++++++  cleaned = cleaned.replace(/\{\{[A-Za-z0-9_]+\}\}/g, '')
+++++++
+++++++  // 1. Strip subordinate participial clauses containing placeholders: e.g. ", reducing latency by [ADD: ...]" or ", achieving [ADD: ...] across teams."
+++++++  cleaned = cleaned.replace(/,\s*(?:reducing|securing|achieving|supporting|delivering|improving|cutting|saving|driving|scaling|optimizing|boosting|generating|utilizing|leveraging)(?:\s+[a-z0-9\s]+)?\s*(?:by|with|to)?\s*\[(?:ADD|TODO|TBD|INSERT)[^\]]*\](?:\s+across\s+[a-z0-9\s]+)?/gi, '')
+++++++
+++++++  // 2. Strip dangling verbs immediately preceding bracket placeholders: e.g. "utilized by [ADD: ...]" or "leveraged with [ADD: ...]"
+++++++  cleaned = cleaned.replace(/\s+(?:utilized|leveraged|achieving|securing|supporting|delivering|utilizing|driving|scaling)\s*(?:by|with|to)?\s*\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]/gi, '')
+++++++
+++++++  // 3. Replace 'by [ADD: ...] and boosted...' -> 'and boosted...'
+++++++  cleaned = cleaned.replace(/\b(?:by|with)\s*\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]\s*(and|while|to)\b/gi, '$1')
+++++++
+++++++  // 4. Strip any remaining raw bracket placeholder: e.g. "[ADD: ...]"
+++++++  cleaned = cleaned.replace(/\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]/gi, '')
+++++++
+++++++  // Purge repetitive microservice boilerplate clauses
+++++++  cleaned = cleaned.replace(/,?\s*by establishing decoupled microservice boundaries and resilient caching(?:,\s*enhancing operational throughput,\s*reducing execution latency,\s*and ensuring continuous production uptime)?\.?/gi, '.')
+++++++  cleaned = cleaned.replace(/,?\s*enhancing operational throughput,\s*reducing execution latency,\s*and ensuring continuous production uptime\.?/gi, '.')
+++++++
+++++++  // 4b. Collapse duplicated prepositions
+++++++  cleaned = cleaned.replace(/\b(by|with|to|in|of|for|and|on|at|from)\s+\1\b/gi, '$1')
+++++++
+++++++  // 5. Clean hanging verbs or prepositions left before punctuation at sentence boundaries: e.g. "utilized." -> "." or "by." -> "."
+++++++  cleaned = cleaned.replace(/\s+(?:utilized|leveraged|utilizing|achieved|driven|by|with|to|of|for|at|in|from)\s*([.,;])/gi, '$1')
+++++++
+++++++  // 6. Normalize punctuation and whitespace: e.g. ",." -> "."
+++++++  cleaned = cleaned.replace(/\s*,\s*\./g, '.')
+++++++  cleaned = cleaned.replace(/,\s*,/g, ',')
+++++++  cleaned = cleaned.replace(/\s{2,}/g, ' ').trim()
+++++++  cleaned = cleaned.replace(/\s+\./g, '.')
+++++++  cleaned = cleaned.replace(/\.+$/, '.')
+++++++  if (cleaned && !/[.!?]$/.test(cleaned)) {
+++++++    cleaned += '.'
+++++++  }
+++++++  return cleaned
+++++++}
+++++++export const cleanPlaceholderClause = cleanPlaceholderGraceful
+++++++
+++++++/**
+++++++ * Builds multi-strategy rewrite index:
+++++++ * 1. bulletId / id exact match
+++++++ * 2. exact text match (case-insensitive, trimmed)
+++++++ * 3. 35-character normalized prefix match
+++++++ */
+++++++export function buildRewriteLookup(tailoredBullets = []) {
+++++++  const idMap = new Map()
+++++++  const exactMap = new Map()
+++++++  const prefixMap = new Map()
+++++++
+++++++  const normalizePrefix = (str, len = 35) => {
+++++++    if (!str) return ''
+++++++    return String(str)
+++++++      .toLowerCase()
+++++++      .replace(/^([•\-\*\u2022\u25e6\u2043\u2219]|\*(?!\*))\s*/, '')
+++++++      .replace(/\s+/g, ' ')
+++++++      .trim()
+++++++      .slice(0, len)
+++++++  }
+++++++
+++++++  if (Array.isArray(tailoredBullets)) {
+++++++    tailoredBullets.forEach((item) => {
+++++++      if (!item) return
+++++++      const id = item.bulletId || item.id
+++++++      const origText = item.originalText || item.text || item.original || item.bullet || ''
+++++++      const rawRewrite =
+++++++        item.rewriteOption ||
+++++++        item.rewrite ||
+++++++        item.suggestedRewrite ||
+++++++        item.rewrittenText ||
+++++++        item.readyToUseRewrite ||
+++++++        (item.originalText && item.text !== item.originalText ? item.text : null)
+++++++
+++++++      if (!rawRewrite || typeof rawRewrite !== 'string') return
+++++++
+++++++      const cleanRw = cleanPlaceholderClause(rawRewrite)
+++++++      if (!cleanRw) return
+++++++
+++++++      const hadPlaceholder = PLACEHOLDER_REGEX.test(rawRewrite)
+++++++      const entry = { text: cleanRw, hadPlaceholder, raw: rawRewrite }
+++++++
+++++++      if (id) {
+++++++        idMap.set(String(id), entry)
+++++++      }
+++++++      if (origText && typeof origText === 'string') {
+++++++        const normExact = origText.toLowerCase().trim()
+++++++        exactMap.set(normExact, entry)
+++++++        const pfx = normalizePrefix(origText, 35)
+++++++        if (pfx.length >= 10) {
+++++++          prefixMap.set(pfx, entry)
+++++++        }
+++++++      }
+++++++    })
+++++++  }
+++++++
+++++++  return {
+++++++    findRewrite(bulletId, rawText) {
+++++++      if (bulletId && idMap.has(String(bulletId))) {
+++++++        return idMap.get(String(bulletId))
+++++++      }
+++++++      if (rawText && typeof rawText === 'string') {
+++++++        const normExact = rawText.toLowerCase().trim()
+++++++        if (exactMap.has(normExact)) {
+++++++          return exactMap.get(normExact)
+++++++        }
+++++++        const pfx = normalizePrefix(rawText, 35)
+++++++        if (pfx.length >= 10 && prefixMap.has(pfx)) {
+++++++          return prefixMap.get(pfx)
+++++++        }
+++++++      }
+++++++      return null
+++++++    },
+++++++  }
+++++++}
