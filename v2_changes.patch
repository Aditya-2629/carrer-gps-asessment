++++++++++++    `[LlmJdAnalyzer] Finished 2-step analysis for "${bucketKey}". Discovered ${marketSkills.length} unique canonical skills across ${totalJds} JDs.`
++++++++++++  )
++++++++++++
++++++++++++  return {
++++++++++++    totalAnalyzed: totalJds,
++++++++++++    marketSkills,
++++++++++++    analyzedAt: new Date().toISOString(),
++++++++++++  }
++++++++++++}
