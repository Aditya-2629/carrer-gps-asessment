+++++++  const assessments = Number(ans.funnel90d?.assessments ?? ans.assessments ?? ans.oas ?? ans.oa ?? 0)
+++++++  const aiInterviews = Number(ans.funnel90d?.aiInterviews ?? ans.aiInterviews ?? 0)
