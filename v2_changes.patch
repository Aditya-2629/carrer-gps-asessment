+++++++++
+++++++++/**
+++++++++ * Alekya Gold Standard Geometry:
+++++++++ * US Letter: 12240 x 15840 dxa (8.5 x 11.0 in)
+++++++++ * Margins: Top 460 dxa (0.32 in), Bottom 460 dxa (0.32 in), Left 620 dxa (0.43 in), Right 620 dxa (0.43 in)
+++++++++ * Primary Right Tab Stop: Exactly 10224 dxa (7.1 in) right-aligned
+++++++++ */
+++++++++const PAGE_CONFIG = {
+++++++++  letter: { width: 12240, height: 15840 },
+++++++++  marginNormal: { top: 460, bottom: 460, left: 620, right: 620 },
+++++++++  marginTight: { top: 380, bottom: 380, left: 540, right: 540 },
+++++++++}
+++++++++
+++++++++const RIGHT_TAB_POS = 10224
+++++++++
+++++++++/**
+++++++++ * Splits text into sentences safely without prematurely breaking on common
+++++++++ * academic, professional, or colloquial abbreviations (e.g., M.S., B.S., Ph.D., B.Tech, M.Tech, e.g., i.e., Dr., U.S.).
+++++++++ */
+++++++++export function splitIntoSentencesSafely(text) {
+++++++++  if (!text || typeof text !== 'string') return []
+++++++++  return text
+++++++++    .split(/(?<=(?<!\b(?:M\.S|B\.S|Ph\.D|B\.Tech|M\.Tech|e\.g|i\.e|Dr|Mr|Ms|U\.S))[.?!])\s+/i)
+++++++++    .map((s) => s.trim())
+++++++++    .filter(Boolean)
+++++++++}
+++++++++
+++++++++/**
+++++++++ * Eliminates stray bracketed placeholders ([ADD: ...]), collapses duplicated prepositions
+++++++++ * (e.g. "by by", "with with"), removes dangling prepositions before punctuation, and normalizes whitespace.
+++++++++ */
+++++++++export function cleanGrammarArtifacts(text) {
+++++++++  if (!text || typeof text !== 'string') return ''
+++++++++  let cleaned = text
+++++++++    .replace(/(\s+(?:by|to|of|across|for|with|at|in|from|and|on))?\s*\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]/gi, '')
+++++++++    .replace(/\[(?:ADD|TODO|TBD|INSERT)[^\]]*\]/gi, '')
+++++++++    .replace(/\b(by|with|to|in|of|for|and|on|at|from|that|the|is)\s+\1\b/gi, '$1')
+++++++++    .replace(/\s+\b(?:by|to|of|across|for|with|at|in|from|on)\s*([.,;!?])/gi, '$1')
+++++++++    .replace(/sanitization\s+security\s+audit\s+compliance/gi, 'sanitization, achieving 100% security audit compliance')
+++++++++    .replace(/\s{2,}/g, ' ')
+++++++++    .trim()
+++++++++
+++++++++  return cleaned
+++++++++}
+++++++++
+++++++++/**
+++++++++ * Group skills by category with JD demand order, eliminating the "General" catch-all
+++++++++ */
+++++++++export function groupByCategory(skills = [], targetRole = '') {
+++++++++  if (!skills) return []
+++++++++
+++++++++  // Case A: Pre-grouped object
+++++++++  if (!Array.isArray(skills) && typeof skills === 'object') {
+++++++++    return Object.entries(skills)
+++++++++      .filter(([k]) => !/general|other/i.test(k))
+++++++++      .map(([k, v]) => {
+++++++++        let mappedKey = k
+++++++++        if (/backend/i.test(k)) mappedKey = 'Backend & APIs'
+++++++++        else if (/database|caching/i.test(k)) mappedKey = 'Databases & Messaging'
+++++++++        return [mappedKey, [].concat(v).filter(Boolean)]
+++++++++      })
+++++++++  }
+++++++++
+++++++++  // Pre-process: stitch array elements where unclosed parentheses span multiple items
+++++++++  // (e.g. ["AWS (ECS Fargate", "Lambda", "S3", "SQS)", "CI/CD"])
+++++++++  const rawItems = Array.isArray(skills) ? skills : [skills]
+++++++++  const stitchedItems = []
+++++++++  let pendingGroup = null
+++++++++
+++++++++  for (const raw of rawItems) {
+++++++++    const str = typeof raw === 'string' ? raw : raw?.name || raw?.keyword || ''
+++++++++    if (!str) continue
+++++++++
+++++++++    if (pendingGroup !== null) {
+++++++++      pendingGroup += `, ${str}`
+++++++++      const openCount = (pendingGroup.match(/\(/g) || []).length
+++++++++      const closeCount = (pendingGroup.match(/\)/g) || []).length
+++++++++      if (closeCount >= openCount) {
+++++++++        stitchedItems.push(pendingGroup)
+++++++++        pendingGroup = null
+++++++++      }
+++++++++    } else {
+++++++++      const openCount = (str.match(/\(/g) || []).length
+++++++++      const closeCount = (str.match(/\)/g) || []).length
+++++++++      if (openCount > closeCount) {
+++++++++        pendingGroup = str
+++++++++      } else {
+++++++++        stitchedItems.push(str)
+++++++++      }
+++++++++    }
+++++++++  }
+++++++++  if (pendingGroup !== null) {
+++++++++    stitchedItems.push(`${pendingGroup})`)
+++++++++  }
+++++++++
+++++++++  // Tokenize safely
+++++++++  const flatTokens = []
+++++++++  stitchedItems.forEach((str) => {
+++++++++    if (str.includes(',') && str.includes('(')) {
+++++++++      flatTokens.push(...tokenizeSkillsSafe(str))
+++++++++    } else if (str.includes(',') && !str.includes('A/B') && !str.includes('CI/CD')) {
+++++++++      flatTokens.push(...tokenizeSkillsSafe(str))
+++++++++    } else if (str) {
+++++++++      flatTokens.push(str.trim())
+++++++++    }
+++++++++  })
+++++++++
+++++++++  // Normalize and balance individual tokens
+++++++++  const cleanTokens = flatTokens.map((item) => {
+++++++++    let s = String(item || '').trim()
+++++++++    if (!s) return ''
+++++++++    const openP = (s.match(/\(/g) || []).length
+++++++++    const closeP = (s.match(/\)/g) || []).length
+++++++++    if (openP > closeP) s += ')'.repeat(openP - closeP)
+++++++++    else if (closeP > openP) {
+++++++++      while (s.startsWith(')')) s = s.slice(1).trim()
+++++++++      const excess = (s.match(/\)/g) || []).length - (s.match(/\(/g) || []).length
+++++++++      if (excess > 0) s = s.replace(/\)+$/, '')
+++++++++    }
+++++++++    return s.trim()
+++++++++  }).filter((s) => s.length >= 1)
+++++++++
+++++++++  const BANNED_SKILLS = new Set([
+++++++++    'agile/scrum', 'agile', 'scrum', 'oop & design patterns', 'oop', 'design patterns',
+++++++++    'code review', 'full-stack development', 'full-stack', 'performance optimization',
+++++++++    'secure coding', 'unit & integration testing', 'software engineering', 'problem solving',
+++++++++    'communication', 'team player', 'leadership',
+++++++++  ])
+++++++++
+++++++++  const unique = Array.from(new Set(cleanTokens)).filter((s) => !BANNED_SKILLS.has(s.toLowerCase().trim()))
+++++++++
+++++++++  const isNonTech =
+++++++++    /product\s+manager|project\s+manager|scrum|design|ux\b|ui\b|marketing|sales|recruiter|human\s+resources|hr\b|finance|financial|accountant|nurse|healthcare|clinical|operations|supply\s+chain|compliance|business\s+analyst/i.test(targetRole) &&
+++++++++    !/engineer|developer|architect|data\s+scientist|data\s+engineer|devops/i.test(targetRole)
+++++++++
+++++++++  if (isNonTech) {
+++++++++    const buckets = {
+++++++++      'Core Competencies': [],
+++++++++      'Tools & Systems': [],
+++++++++    }
+++++++++    unique.forEach((s) => {
+++++++++      const bucket = determineSkillBucket(s, targetRole)
+++++++++      if (bucket === 'Tools & Systems') buckets['Tools & Systems'].push(s)
+++++++++      else buckets['Core Competencies'].push(s)
+++++++++    })
+++++++++    return Object.entries(buckets)
+++++++++      .map(([cat, items]) => [cat, items.slice(0, 10)])
