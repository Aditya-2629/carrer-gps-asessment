++++++++  isConcreteTechSkill,
++++++++  BANNED_GENERIC_WORDS,
++++++++  DYNAMIC_EXTRACTOR_SYSTEM_PROMPT,
++++++++  JD_SKILL_CACHE,
++++++++  clearJdSkillCache,
++++++++}
