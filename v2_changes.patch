+++++++++                  className="w-12 h-7 text-center text-xs font-bold font-mono rounded-lg bg-[var(--surface-base)] border border-[var(--border-default)] text-[var(--text-primary)] focus:border-[var(--primary)] focus:outline-none shrink-0"
