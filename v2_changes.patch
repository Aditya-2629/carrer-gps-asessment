+++++++++      }
+++++++++    }
+++++++++
+++++++++    return parsed
+++++++++  } catch (err) {
+++++++++    console.error('[AIResumeParser] Failed to parse resume with LLM:', err.message)
+++++++++    throw err
+++++++++  }
+++++++++}
