+++++++          }
+++++++        }
+++++++      }
+++++++
+++++++      // Method/Tooling clause injection for verified keywords not yet in a bullet
+++++++      for (const item of verifiedKeywordsToInject) {
+++++++        if (item.injectedInBullet) continue
