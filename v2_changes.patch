++++  phase3MaxFinalRounds30d: 3,          // < 3 final rounds in 30d despite tech rounds -> Phase 3
++++  phase4MinFinalRounds30d: 3,          // >= 3 final rounds (or >= 2 in 30d / >= 3 in 90d) with 0 offers -> Phase 4
