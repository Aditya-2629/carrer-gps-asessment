++++        const canonical = typeof item.canonical === 'string' ? item.canonical.trim() : ''
++++        TAXONOMY_CANONICAL_CACHE.set(item.term.toLowerCase(), canonical)
++++        resultMap.set(item.term, canonical)
++++      }
++++    }
