+++++++++++    if (token.startsWith('**') && token.endsWith('**') && token.length >= 4) {
+++++++++++      return (
+++++++++++        <strong key={i} className="font-bold text-[var(--text-primary)]">
+++++++++++          {token.slice(2, -2)}
