++++++++++++  const marketSkills = Array.from(skillOccurrences.values())
++++++++++++    .map((s) => {
++++++++++++      const percentage = Math.round((s.count / totalJds) * 100)
++++++++++++      const priority = percentage >= 40 ? 'HIGH' : percentage >= 20 ? 'MEDIUM' : 'LOW'
++++++++++++      return {
++++++++++++        name: s.canonicalName,
++++++++++++        category: s.category,
++++++++++++        count: s.count,
++++++++++++        frequency: s.count,
