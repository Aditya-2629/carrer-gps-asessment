+++++++++  const handleSelectPreset = (p) => {
+++++++++    setVal(p)
+++++++++    onChange(p)
+++++++++  }
+++++++++
+++++++++  const handleCustomInput = (text) => {
+++++++++    setVal(text)
+++++++++    onChange(text)
+++++++++  }
+++++++++
+++++++++  const isRangePreset = /[–—-]/.test(val)
