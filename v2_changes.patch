+  'google cloud platform': 'Google Cloud',
+  'google cloud': 'Google Cloud',
+  'bigquery': 'BigQuery',
+  'google bigquery': 'BigQuery',
+  'dbt': 'dbt',
+  'dbt core': 'dbt',
+  'node': 'Node.js',
+  'node.js': 'Node.js',
+  'nodejs': 'Node.js',
+  'node js': 'Node.js',
+  'react': 'React',
+  'react.js': 'React',
+  'reactjs': 'React',
+  'react js': 'React',
+  'vue': 'Vue.js',
+  'vue.js': 'Vue.js',
