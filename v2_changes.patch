+++++++++++          sanitized.skills[categoryBucket].push(keyword)
+++++++++++        }
+++++++++++      } else {
+++++++++++        sanitized.skills = [keyword]
+++++++++++      }
+++++++++++      existingSkillsSet.add(kwLow)
