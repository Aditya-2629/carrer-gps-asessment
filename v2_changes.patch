++++++++++++export async function analyzeAndAggregateJdCorpus(rawJds = [], bucketKey = '') {
++++++++++++  if (!Array.isArray(rawJds) || rawJds.length === 0) {
++++++++++++    return { totalAnalyzed: 0, marketSkills: [] }
