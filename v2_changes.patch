+++++++++        const result = {
+++++++++          skills: Array.from(new Set(skillNames)),
+++++++++          categories,
+++++++++          seniority: parsed.seniority || 'Mid-Level',
+++++++++          minYears: parsed.minYears || 0,
+++++++++          source: 'dynamic_llm',
