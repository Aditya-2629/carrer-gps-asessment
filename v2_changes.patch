++++++++    return {
++++++++      index: idx,
++++++++      company: exp.company || `Company ${idx + 1}`,
++++++++      isCurrent: isRoleCurrent(exp),
++++++++      bullets: [...rawBullets],
++++++++      modifiedCount: 0,
++++++++      synthesizedCount: 0,
