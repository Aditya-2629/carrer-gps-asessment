++++++++    const isCurrent = exp.isCurrent === true || /present|current|now/i.test(exp.endDate || '') || /present|current|now/i.test(exp.dates || '') || /present|current|now/i.test(exp.duration || '')
++++++++
++++++++    const cleanBullets = []
++++++++    ;(exp.bullets || []).forEach((b) => {
