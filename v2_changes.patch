++++++++    if (dynamicCategory === 'languages_frameworks') {
++++++++      if (/react|ui|vue|front|tailwind|css/i.test(kw)) return 'frontend_slot'
++++++++      return 'api_slot'
++++++++    }
++++++++  }
++++++++
++++++++  // Fallback to pattern matcher
++++++++  const low = String(kw || '').toLowerCase()
