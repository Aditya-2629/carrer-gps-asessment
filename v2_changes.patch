++++++++++++  // Execution 1: First key fails with 429 quota error, second key succeeds
++++++++++++  const res1 = await mockPool.executeWithRetry(async (key) => {
++++++++++++    callCount++
++++++++++++    attemptedKeys.push(key)
++++++++++++    if (key === 'invalid_test_key_123') {
