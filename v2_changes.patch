+++        })
+++      }
+++    }
+++
+++    // If within target pages, we're done
+++    if (finalPages <= targetPages) {
+++      break
+++    }
+++  }
+++
+++  if (!bestBuffer || bestBuffer.length === 0 || bestBuffer[0] !== 0x50 || bestBuffer[1] !== 0x4b) {
