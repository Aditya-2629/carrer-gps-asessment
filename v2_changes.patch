++++++++      if (exists) {
++++++++        updated = prev.filter((s) => s.toLowerCase() !== skill.toLowerCase())
++++++++        onToast(`Removed "${skill}" from Interview Defense sheet`)
++++++++      } else {
++++++++        updated = [...prev, skill]
++++++++        onToast(`Skill updated in report successfully! Added "${skill}".`)
