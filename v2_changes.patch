++++++++export function getRewriteHash(bulletId, originalText, skills = []) {
++++++++  const normSkills = [...skills].map((s) => (typeof s === 'string' ? s : s?.skill || s?.keyword || s?.name || '').toLowerCase().trim()).filter(Boolean).sort().join('|')
