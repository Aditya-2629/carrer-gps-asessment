++++++++    // Role cleaner with word boundary
++++++++    role = role.replace(/\s*[(|,-]?\s*\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{4}.*$/i, '')
