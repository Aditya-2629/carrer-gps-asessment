+++++++          balance++
+++++++          repaired += char
+++++++        } else if (char === ')') {
+++++++          if (balance > 0) {
+++++++            balance--
+++++++            repaired += char
+++++++          }
+++++++        } else {
+++++++          repaired += char
+++++++        }
+++++++      }
+++++++      if (balance > 0) {
