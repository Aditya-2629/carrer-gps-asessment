+++++      recruiterScreens,
+++++      assessments,
+++++      aiInterviews,
+++++      screens90d,
+++++      screens30d,
+++++      technicalRounds: techs90d,
+++++      finalRounds: finals90d,
+++++      offers: offers90d,
+++++      joiningStatus: joiningStatus || 'No Offer Yet',
+++++    },
+++++  }
