+++++++      // Line 2: Company Name | City, State/Country (Work Mode)
+++++++      const companyMeta = [decodeHtmlEntities(exp.company), decodeHtmlEntities(exp.location)].filter(Boolean).join(' | ')
+++++++      if (companyMeta) {
+++++++        children.push(
+++++++          new Paragraph({
+++++++            spacing: { before: 0, after: 55 },
