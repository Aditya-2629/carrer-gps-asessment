+++++  // 1. Funnel Metric Normalization (30-Day Pace & 90-Day Totals)
+++++  const apps30d = extractQuantMetric(ans.apps30d ?? (ans.appsWeek ? ans.appsWeek * 4.33 : null), 0, 'month').rawNum
