+++++++ */
+++++++export async function extractSkillsFromSingleJd({ jobTitle = '', jobDescription = '', timeoutMs = 15000 }) {
+++++++  if (!jobDescription || typeof jobDescription !== 'string' || jobDescription.trim().length < 20) {
