PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/career-gps?retryWrites=true&w=majority

# Google Gemini AI Configuration (Primary model: gemini-3.6-flash with multi-key / multi-model fallback)
GEMINI_API_KEY=your_gemini_api_key_here
# Additional fallback keys (auto-rotated if primary hits quota/rate limits):
GEMINI_API_KEY_FALLBACK_1=your_second_gemini_api_key_here
GEMINI_API_KEY_FALLBACK_2=your_third_gemini_api_key_here
# Or provide comma-separated list:
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.6-flash

# Gmail SMTP SSL Configuration (Production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Career GPS <your_email@gmail.com>
FRONTEND_URL=http://localhost:5173

# --- Resume Agent V1.2 (Isolated Experiment) Configuration ---
GROQ_API_KEY=your_groq_api_key_here
# Additional fallback keys (auto-rotated if primary hits quota/rate limits):
GROQ_API_KEY_FALLBACK_1=your_second_groq_api_key_here
GROQ_API_KEY_FALLBACK_2=your_third_groq_api_key_here
GROQ_API_KEY_FALLBACK_3=your_fourth_groq_api_key_here
GROQ_API_KEY_FALLBACK_4=your_fifth_groq_api_key_here
# Or provide comma-separated list:
# GROQ_API_KEYS=key1,key2,key3,key4,key5
GROQ_RESUME_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_RESUME_MODEL_FALLBACK=openai/gpt-oss-20b
AI_RESUME_PROVIDER=groq
AI_RESUME_FALLBACK_ENABLED=false
RESUME_AGENT_TEST_MODE=true

# Secondary / Reference Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_RESUME_MODEL=google/gemma-4-26b-a4b-it:free
GROK_API_KEY=your_xai_grok_api_key_here

# NVIDIA NIM AI Configuration (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RESUME_MODEL=nvidia/nemotron-3-super-120b-a12b

