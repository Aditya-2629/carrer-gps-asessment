# ── Server & Database ──
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/career-gps?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173

# ── Primary LLM Provider: OpenRouter ──
# Single unified gateway for all agents (Gemini Flash Lite, Llama 3.3 70B, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Secondary Fallback Provider: Groq (Multi-Key Pool) ──
# Auto-rotated via SmartKeyPool on 8k TPM limits. Model locked strictly to openai/gpt-oss-120b.
GROQ_API_KEY=your_primary_groq_key_here
GROQ_API_KEY_FALLBACK_1=your_second_groq_key_here
GROQ_API_KEY_FALLBACK_2=your_third_groq_key_here
GROQ_API_KEY_FALLBACK_3=your_fourth_groq_key_here
GROQ_API_KEY_FALLBACK_4=your_fifth_groq_key_here
# Or comma-separated: GROQ_API_KEYS=key1,key2,key3,key4,key5

# ── Apify LinkedIn & Market Scraping ──
APIFY_API_TOKEN=your_apify_api_token_here
# Additional backup keys rotated via SmartKeyPool:
# APIFY_API_TOKENS=token1,token2
APIFY_LINKEDIN_ACTOR_ID=harvestapi/linkedin-profile-scraper
APIFY_LINKEDIN_POSTS_ACTOR_ID=harvestapi/linkedin-profile-posts
APIFY_LINKEDIN_MAX_POSTS=15
APIFY_LINKEDIN_MAX_ITEMS=50

# ── Gmail SMTP SSL Notification Service ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Career GPS <your_email@gmail.com>

# ── Admin Panel Authentication ──
ADMIN_EMAIL=inspiracustomer@gmail.com
ADMIN_PASSWORD=crafture-admin-2026
ADMIN_SESSION_SECRET=change-this-secret-in-production

# ── Quality Gate ──
JUDGE_ENABLED=true
